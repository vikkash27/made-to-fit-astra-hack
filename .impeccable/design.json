      "css": ".ds-concept{font-family:var(--font-sans,\"Geist\",ui-sans-serif,system-ui,sans-serif);display:flex;flex-direction:column;justify-content:center;gap:4px;height:112px;padding:12px 48px 12px 20px;border:1px solid var(--border,oklch(0.88 0.008 90));border-radius:2px;background:var(--surface,oklch(1 0 0));text-align:left;transition:border-color .15s}.ds-concept[aria-pressed=true]{border-color:var(--primary,oklch(0.64 0.15 45))}.ds-concept:hover{border-color:var(--muted-foreground,oklch(0.48 0.008 230))}.ds-concept[aria-pressed=true]:hover{border-color:var(--primary,oklch(0.64 0.15 45))}.ds-concept-number{font-family:var(--font-mono,\"JetBrains Mono\",monospace);font-size:12px;line-height:16px;color:var(--primary,oklch(0.64 0.15 45))}.ds-concept-title{font-size:15px;color:var(--foreground,oklch(0.2 0.006 236))}.ds-concept-detail{font-size:12px;line-height:16px;color:var(--muted-foreground,oklch(0.48 0.008 230))}.ds-concept:focus-visible{outline:2px solid var(--ring,oklch(0.64 0.15 45));outline-offset:2px}"

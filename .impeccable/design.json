  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Shared rounded workspace action.",
      "html": "<button class=\"ds-button-primary\">Continue to measurements</button>",
      "css": ".ds-button-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:40px;border-radius:9999px;padding:8px 16px;font:500 14px/20px var(--font-sans);cursor:pointer;transition:background-color 150ms,border-color 150ms,color 150ms;background:var(--primary);color:var(--primary-foreground);border:0;}.ds-button-primary:hover{background:color-mix(in oklab,var(--primary) 90%,transparent);}.ds-button-primary:focus-visible{outline:2px solid var(--primary);outline-offset:2px}.ds-button-primary:disabled{pointer-events:none;opacity:.4}"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Shared rounded workspace action.",
      "html": "<button class=\"ds-button-outline\">Ask Astra</button>",
      "css": ".ds-button-outline{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:40px;border-radius:9999px;padding:8px 16px;font:500 14px/20px var(--font-sans);cursor:pointer;transition:background-color 150ms,border-color 150ms,color 150ms;background:transparent;color:var(--foreground);border:1px solid var(--border);}.ds-button-outline:hover{border-color:var(--muted-foreground);}.ds-button-outline:focus-visible{outline:2px solid var(--primary);outline-offset:2px}.ds-button-outline:disabled{pointer-events:none;opacity:.4}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Shared rounded workspace action.",
      "html": "<button class=\"ds-button-ghost\">Back to parts</button>",
      "css": ".ds-button-ghost{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:40px;border-radius:9999px;padding:8px 16px;font:500 14px/20px var(--font-sans);cursor:pointer;transition:background-color 150ms,border-color 150ms,color 150ms;background:transparent;color:color-mix(in oklab,var(--foreground) 90%,transparent);border:0;}.ds-button-ghost:hover{background:var(--accent);}.ds-button-ghost:focus-visible{outline:2px solid var(--primary);outline-offset:2px}.ds-button-ghost:disabled{pointer-events:none;opacity:.4}"
    },
    {
      "name": "Dimension Field",
      "kind": "input",
      "refersTo": "dimension-input",
      "description": "Labelled numeric field with visible units and unknown blank value.",
      "html": "<label class=\"ds-dimension-label\">Width<div class=\"ds-dimension-field\"><input aria-label=\"Width in millimetres\" inputmode=\"decimal\" placeholder=\"Unknown\"><span>mm</span></div></label>",
      "css": ".ds-dimension-label{font:500 12px/16px var(--font-sans);color:var(--muted-foreground)}.ds-dimension-field{display:flex;align-items:center;margin-top:4px;border:1px solid var(--border);border-radius:8px;background:var(--background)}.ds-dimension-field input{width:100%;min-width:0;border:0;background:transparent;padding:6px 8px;font:400 14px/20px var(--font-mono);color:var(--foreground)}.ds-dimension-field span{padding-right:8px;font:12px var(--font-sans)}.ds-dimension-field:hover{border-color:var(--muted-foreground)}.ds-dimension-field:focus-within{border-color:var(--primary)}.ds-dimension-field input:focus-visible{outline:2px solid var(--primary);outline-offset:2px}"
    },
    {
      "name": "Project Stages",
      "kind": "nav",
      "refersTo": "stage-navigation-item",
      "description": "Scrollable stage strip with current step and explicit labels.",
      "html": "<nav class=\"ds-stages\" aria-label=\"Project stages\"><button>1 \u00b7 Review parts</button><button aria-current=\"step\">2 \u00b7 Choose a project</button><button>3 \u00b7 Measure parts</button></nav>",
      "css": ".ds-stages{display:flex;gap:8px;overflow-x:auto;padding-bottom:8px}.ds-stages button{flex-shrink:0;min-height:44px;padding:0 16px;border:0;border-radius:9999px;background:transparent;color:var(--foreground);font:400 14px/20px var(--font-sans);cursor:pointer}.ds-stages button:hover{background:var(--muted)}.ds-stages button[aria-current]{background:var(--accent);color:var(--primary);font-weight:600}.ds-stages button:focus-visible{outline:2px solid var(--primary);outline-offset:2px}"
    },
    {
      "name": "Review Status",
      "kind": "chip",
      "refersTo": "status-pill",
      "description": "Text accompanies confirmed and proposed state colors.",
      "html": "<span class=\"ds-status ds-status-confirmed\">Confirmed</span><span class=\"ds-status ds-status-proposed\">Needs review</span>",
      "css": ".ds-status{display:inline-flex;border-radius:9999px;padding:4px 8px;font:400 12px/16px var(--font-sans)}.ds-status-confirmed{color:var(--success);background:color-mix(in oklab,var(--success) 5%,transparent)}.ds-status-proposed{color:var(--primary);background:color-mix(in oklab,var(--primary) 5%,transparent)}"
    },
    {
      "name": "Concept Choice",
      "kind": "card",
      "refersTo": "artifact-surface",
      "description": "Bordered artifact choice; orange indicates the current selection.",
      "html": "<button class=\"ds-concept\" aria-pressed=\"true\"><strong>Desk sensor</strong><span>A project around your reviewed components.</span></button>",
      "css": ".ds-concept{display:block;width:100%;border:1px solid var(--border);border-radius:16px;background:var(--surface);padding:20px;text-align:left;color:var(--foreground);font:400 14px/20px var(--font-sans);cursor:pointer}.ds-concept strong{display:block;font-size:16px;line-height:24px;font-weight:600}.ds-concept span{display:block;margin-top:8px;color:var(--muted-foreground)}.ds-concept:hover{background:var(--muted)}.ds-concept[aria-pressed=true]{border-color:var(--primary);background:var(--accent)}.ds-concept:focus-visible{outline:2px solid var(--primary);outline-offset:2px}"
    },
    {
      "name": "Home Composer",
      "kind": "custom",
      "refersTo": "composer",
      "description": "Labelled two-row composer in the inherited theme.",
      "html": "<div class=\"ds-composer\"><label for=\"ds-project-idea\">Your parts or project idea</label><textarea id=\"ds-project-idea\" rows=\"2\" placeholder=\"I have a controller, a small display and a battery\u2026\"></textarea><button>Start project</button></div>",
      "css": ".ds-composer{border:1px solid var(--border);border-radius:16px;padding:12px;background:var(--surface);color:var(--foreground);font:400 14px/20px var(--font-sans)}.ds-composer label{display:block;padding:4px 8px;font-weight:500}.ds-composer textarea{display:block;width:calc(100% - 16px);border:0;background:transparent;resize:none;padding:12px 8px;color:var(--foreground);font:400 16px/26px var(--font-sans)}.ds-composer textarea::placeholder{color:var(--muted-foreground)}.ds-composer button{display:block;margin-left:auto;min-height:44px;border:0;border-radius:9999px;padding:8px 16px;background:var(--primary);color:var(--primary-foreground);font:500 14px/20px var(--font-sans);cursor:pointer}.ds-composer button:hover{opacity:.9}.ds-composer button:focus-visible{outline:2px solid var(--primary);outline-offset:2px}.ds-composer textarea:focus-visible{outline:2px solid var(--primary);outline-offset:2px}"
    },
    {
      "name": "Viewer Modes",
      "kind": "nav",
      "refersTo": "stage-navigation-item",
      "description": "Wrapping CAD/appearance modes keep the canvas unobscured.",
      "html": "<div class=\"ds-viewer-toolbar\"><div class=\"ds-viewer-modes\" role=\"radiogroup\" aria-label=\"View mode\"><button role=\"radio\" aria-checked=\"true\">CAD</button><button role=\"radio\" aria-checked=\"false\">Rendered</button><button role=\"radio\" aria-checked=\"false\">Overlay</button></div></div>",
      "css": ".ds-viewer-toolbar{display:flex;flex-wrap:wrap;gap:8px;padding:12px;border-bottom:1px solid var(--border);background:white}.ds-viewer-modes{display:flex;border-radius:9999px;background:var(--muted);padding:4px}.ds-viewer-modes button{min-height:32px;border:0;border-radius:9999px;padding:4px 12px;background:transparent;color:var(--muted-foreground);font:400 12px/16px var(--font-sans);cursor:pointer}.ds-viewer-modes button[aria-checked=true]{background:white;color:var(--primary);font-weight:500}.ds-viewer-modes button:hover{color:var(--foreground)}.ds-viewer-modes button:focus-visible{outline:2px solid var(--primary);outline-offset:2px}"
    }
